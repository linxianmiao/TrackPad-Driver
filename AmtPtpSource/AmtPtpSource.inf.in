; Source template. Only New-MagicPadSourceTestPackage.ps1 materializes a test INF.
; This source driver owns the HID service's L2CAP channels instead of HidBth.
[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%Provider%
DriverVer=09/08/2026,0.2.0.2
CatalogFile=AmtPtpSource.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000
[Models.NTamd64.10.0...22000]
%DeviceDesc%=Source,BTHENUM\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004C_PID&0324

[DestinationDirs]
SourceFiles=13
[SourceDisksNames]
1=%DeviceDesc%
[SourceDisksFiles]
AmtPtpSource.sys=1
[Source.NT]
CopyFiles=SourceFiles
[SourceFiles]
AmtPtpSource.sys
[Source.NT.HW]
AddReg=VhfLower
[VhfLower]
HKR,,LowerFilters,0x00010000,"vhf"
[Source.NT.Services]
AddService=AmtPtpSource,0x00000002,SourceService
[SourceService]
DisplayName=%DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\AmtPtpSource.sys
[Source.NT.Wdf]
KmdfService=AmtPtpSource,SourceWdf
[SourceWdf]
KmdfLibraryVersion=1.15
[Strings]
Provider="MagicPad Native PTP Project"
DeviceDesc="MagicPad Bluetooth PTP source (development)"
